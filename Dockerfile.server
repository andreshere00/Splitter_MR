# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS builder

ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+server
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=0

COPY --from=ghcr.io/astral-sh/uv:0.6.4 /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src

RUN uv sync --frozen --no-dev --extra mcp --no-editable

FROM python:3.12-slim AS runtime

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SPLITTER_MR_HOST=0.0.0.0
ENV SPLITTER_MR_PORT=8000

RUN useradd --create-home --uid 1000 splitter

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src

USER splitter
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"

CMD ["splitter-mr-mcp", "--host", "0.0.0.0", "--port", "8000"]
